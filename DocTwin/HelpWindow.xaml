<Window x:Class="DocTwin.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Help | DocTwin" Icon="Assets/DocTwin.ico" Style="{StaticResource WindowStyle}" Width="980" Height="720" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource CanvasBrush}"
        FontFamily="Segoe UI" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="26,20">
            <StackPanel Orientation="Horizontal">
                <ContentControl ContentTemplate="{StaticResource BrandMarkTemplate}" VerticalAlignment="Center" />
                <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="DocTwin" Foreground="{DynamicResource InkBrush}" FontSize="18" FontWeight="Bold" />
                    <Button Content="Switch theme" Click="ThemeButton_Click" Style="{StaticResource QuietButtonStyle}" HorizontalAlignment="Left" ToolTip="Switch between Light and Dark. Your appearance preference is saved locally." /><TextBlock Text="HELP &amp; ABOUT" Foreground="{DynamicResource MutedBrush}" FontSize="9"
                               FontWeight="SemiBold" Margin="1,3,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Label Content="_Search help" Target="{Binding ElementName=HelpSearch}" Foreground="{DynamicResource InkBrush}" />
            <TextBox x:Name="HelpSearch" Grid.Row="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Search help topics" MaxLength="200" Margin="0,0,0,12" />
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="{Binding SearchSummary}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding Topics}" SelectedItem="{Binding SelectedTopic}"
                             AutomationProperties.Name="Help topics" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate><DataTemplate>
                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Padding="6,8" />
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
                <TextBox Grid.Column="2" Text="{Binding SelectedTopic.Body, Mode=OneWay, TargetNullValue='No matching topic selected.'}"
                         IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="14"
                         AutomationProperties.Name="Help topic details" />
            </Grid>
        </Grid>
        <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,12">
            <Grid>
                <TextBlock Text="Developed by Dawood Ali" Foreground="{DynamicResource MutedBrush}"
                           FontSize="11" VerticalAlignment="Center" />
                <Button Content="Close" Style="{StaticResource PrimaryButtonStyle}" Padding="15,8"
                        HorizontalAlignment="Right" IsDefault="True" IsCancel="True" Click="CloseButton_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
