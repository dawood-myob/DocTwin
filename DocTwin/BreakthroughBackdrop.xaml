<UserControl x:Class="DocTwin.BreakthroughBackdrop"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False" Focusable="False" IsTabStop="False"
             AutomationProperties.AutomationId="BreakthroughBackdrop">
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="VioletGlow" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                     From="0" To="90" Duration="0:0:16" AutoReverse="True" RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="VioletGlow" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="0" To="50" Duration="0:0:11" AutoReverse="True" RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="PinkGlow" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                     From="0" To="-80" Duration="0:0:13" AutoReverse="True" RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="PinkGlow" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="0" To="-40" Duration="0:0:17" AutoReverse="True" RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="DotField" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                     From="0" To="-12" Duration="0:0:5" RepeatBehavior="Forever" />
                    <DoubleAnimation Storyboard.TargetName="DotField" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="0" To="12" Duration="0:0:7" RepeatBehavior="Forever" />
                    <DoubleAnimation Storyboard.TargetName="DotMask" Storyboard.TargetProperty="Opacity"
                                     From="0.35" To="1" Duration="0:0:4" AutoReverse="True" RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
    <Grid ClipToBounds="True" IsHitTestVisible="False">
        <Ellipse x:Name="VioletGlow" Width="980" Height="760" HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="-220,-260,0,0" Opacity="{DynamicResource BackdropGlowOpacity}">
            <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#FF7B14EF" Offset="0" />
                    <GradientStop Color="#007B14EF" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse x:Name="PinkGlow" Width="760" Height="560" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Margin="0,0,-200,-220" Opacity="{DynamicResource BackdropGlowOpacity}">
            <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#FFFE02A7" Offset="0" />
                    <GradientStop Color="#00FE02A7" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Grid x:Name="DotMask" Width="620" Height="460" HorizontalAlignment="Right" VerticalAlignment="Top" ClipToBounds="True"
              Opacity="0.7">
            <Grid.OpacityMask>
                <RadialGradientBrush Center="0.7,0.3" GradientOrigin="0.7,0.3" RadiusX="0.65" RadiusY="0.7">
                    <GradientStop Color="#FF000000" Offset="0" />
                    <GradientStop Color="#00000000" Offset="1" />
                </RadialGradientBrush>
            </Grid.OpacityMask>
            <Rectangle x:Name="DotField" Width="650" Height="490" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,-12,0,0">
                <Rectangle.RenderTransform><TranslateTransform /></Rectangle.RenderTransform>
                <Rectangle.Fill>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,12,12" ViewportUnits="Absolute" Viewbox="0,0,12,12" ViewboxUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing Brush="#FFC497FE">
                                <GeometryDrawing.Geometry>
                                    <EllipseGeometry Center="6,6" RadiusX="1.5" RadiusY="1.5" />
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>
    </Grid>
</UserControl>
