<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <sys:Double x:Key="BackdropGlowOpacity">0.42</sys:Double>
    <Color x:Key="BackgroundPrimaryColor">#FF140A22</Color>
    <Color x:Key="BackgroundSecondaryColor">#FF20122F</Color>
    <Color x:Key="AccentColor">#FFC497FE</Color>
    <Color x:Key="AccentHoverColor">#FFEBDCFD</Color>
    <Color x:Key="AccentPressedColor">#FFA877F2</Color>
    <Color x:Key="TextPrimaryColor">#FFF6F1FB</Color>
    <Color x:Key="TextMutedColor">#FFB9AACF</Color>
    <Color x:Key="BorderColor">#FF3F2A5C</Color>

    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource BackgroundPrimaryColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource BackgroundSecondaryColor}" />
    <SolidColorBrush x:Key="ElevatedBrush" Color="#FF3A2552" />
    <SolidColorBrush x:Key="InputBrush" Color="#FF180D28" />
    <SolidColorBrush x:Key="AlternateRowBrush" Color="#FF1A0F2A" />
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TealBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="TealHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="BrandTintBrush" Color="#22C497FE" />
    <SolidColorBrush x:Key="HoverTintBrush" Color="#14C497FE" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#33C497FE" />
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#FF0F0719" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FFFDA4AF" />
    <FontFamily x:Key="AppFont">Segoe UI</FontFamily>
    <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF20122F" Offset="0" />
        <GradientStop Color="#FF4B1A7A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BreakthroughBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF7B14EF" Offset="0" />
        <GradientStop Color="#FFFE02A7" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
