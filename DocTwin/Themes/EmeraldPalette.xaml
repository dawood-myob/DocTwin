<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BackgroundPrimaryColor">#FF0F172A</Color>
    <Color x:Key="BackgroundSecondaryColor">#FF1E293B</Color>
    <Color x:Key="AccentColor">#FF10B981</Color>
    <Color x:Key="AccentHoverColor">#FF34D399</Color>
    <Color x:Key="AccentPressedColor">#FF059669</Color>
    <Color x:Key="TextPrimaryColor">#FFF8FAFC</Color>
    <Color x:Key="TextMutedColor">#FF94A3B8</Color>
    <Color x:Key="BorderColor">#FF334155</Color>

    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource BackgroundPrimaryColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource BackgroundSecondaryColor}" />
    <SolidColorBrush x:Key="ElevatedBrush" Color="#FF334155" />
    <SolidColorBrush x:Key="InputBrush" Color="#FF111C30" />
    <SolidColorBrush x:Key="AlternateRowBrush" Color="#FF192538" />
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TealBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="TealHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FF071C16" />
    <SolidColorBrush x:Key="BrandTintBrush" Color="#2210B981" />
    <SolidColorBrush x:Key="HoverTintBrush" Color="#1410B981" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#3310B981" />
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#FF0C1424" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FFFDA4AF" />
    <FontFamily x:Key="AppFont">Segoe UI</FontFamily>
    <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF1E293B" Offset="0" />
        <GradientStop Color="#FF123C38" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
