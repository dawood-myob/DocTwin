<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <sys:Double x:Key="BackdropGlowOpacity">0.16</sys:Double>
    <Color x:Key="BackgroundPrimaryColor">#FFF7F6F1</Color>
    <Color x:Key="BackgroundSecondaryColor">#FFFFFFFF</Color>
    <Color x:Key="AccentColor">#FF7B14EF</Color>
    <Color x:Key="AccentHoverColor">#FF6A0DD6</Color>
    <Color x:Key="AccentPressedColor">#FF5A0AB5</Color>
    <Color x:Key="TextPrimaryColor">#FF000000</Color>
    <Color x:Key="TextMutedColor">#FF5F5075</Color>
    <Color x:Key="BorderColor">#FFE6E0D1</Color>
    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource BackgroundPrimaryColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource BackgroundSecondaryColor}" />
    <SolidColorBrush x:Key="ElevatedBrush" Color="#FFEBDCFD" />
    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="AlternateRowBrush" Color="#FFF7F1FE" />
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TealBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="TealHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="BrandTintBrush" Color="#127B14EF" />
    <SolidColorBrush x:Key="HoverTintBrush" Color="#0D7B14EF" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#227B14EF" />
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#FFF2EFE8" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FFBE123C" />
    <FontFamily x:Key="AppFont">Segoe UI</FontFamily>
    <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFFFF" Offset="0" />
        <GradientStop Color="#FFEBDCFD" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BreakthroughBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF7B14EF" Offset="0" />
        <GradientStop Color="#FFFE02A7" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
