<Window x:Class="DocTwin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:DocTwin.Themes" xmlns:local="clr-namespace:DocTwin"
        Title="DocTwin | Knowledge Integrity Copilot | #Breakthrough Build"
        Icon="Assets/DocTwin.ico" Style="{StaticResource WindowStyle}"
        Width="1380" Height="900" MinWidth="1020" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource CanvasBrush}"
        FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <local:BreakthroughBackdrop Grid.ColumnSpan="2" />
        <Border Grid.ColumnSpan="2" Height="4" VerticalAlignment="Top" Panel.ZIndex="10" IsHitTestVisible="False" Background="{DynamicResource BreakthroughBrush}" />

        <Grid Grid.Column="0" Background="{DynamicResource SidebarBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="24,27,24,0" Orientation="Horizontal">
                <ContentControl ContentTemplate="{StaticResource BrandMarkTemplate}" VerticalAlignment="Center" />
                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="DocTwin" Foreground="{DynamicResource InkBrush}" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="KNOWLEDGE INTEGRITY" Foreground="{DynamicResource MutedBrush}" FontSize="9"
                               FontWeight="SemiBold" Margin="1,3,0,0" />
                    <ContentControl ContentTemplate="{StaticResource BreakthroughBadgeTemplate}" Content="{x:Null}" HorizontalAlignment="Left" Margin="0,8,0,0" Focusable="False" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="16,48,16,0">
                <TextBlock Text="WORKSPACE" Foreground="{DynamicResource MutedBrush}" FontSize="10" FontWeight="SemiBold"
                           Margin="13,0,0,13" />
                <Button Style="{StaticResource SidebarButtonStyle}" Background="{DynamicResource SelectionBrush}" Foreground="{DynamicResource TealHoverBrush}"
                        IsHitTestVisible="False" Focusable="False" Margin="0,0,0,5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="29" />
                        <TextBlock Text="Overview" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SidebarButtonStyle}" Click="HelpButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE897;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="29" />
                        <TextBlock Text="How it works" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="24,0,24,22">
                <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,0,0,18" />
                <Border Background="{DynamicResource BrandTintBrush}" CornerRadius="7" Padding="10,9">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource TealHoverBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="  PROTOTYPE MODE" Foreground="{DynamicResource InkBrush}" FontSize="10"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <TextBlock Text="Read-only by design. People review every finding."
                           Foreground="{DynamicResource MutedBrush}" FontSize="11" LineHeight="17" TextWrapping="Wrap"
                           Margin="1,12,0,0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="68" />
                <RowDefinition Height="*" />
                <RowDefinition Height="48" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="34,0,38,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Workspace  /  Overview" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
                        <ContentControl ContentTemplate="{StaticResource BreakthroughBadgeTemplate}" Content="{x:Null}" Margin="16,0,0,0" Focusable="False" />
                    </StackPanel>
                    <Button Content="Switch theme" Click="ThemeButton_Click" Style="{StaticResource QuietButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,85,0" ToolTip="Switch between Light and Dark. Your appearance preference is saved locally." />
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource QuietButtonStyle}"
                            Click="HelpButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE897;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" />
                            <TextBlock Text="Help" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="1040" HorizontalAlignment="Center" Margin="38,32,38,34">
                    <TextBlock Text="Welcome to DocTwin" Foreground="{DynamicResource InkBrush}"
                               FontSize="25" FontWeight="Bold" />
                    <TextBlock Text="A calmer, clearer way to find the knowledge your team can trust."
                               Foreground="{DynamicResource MutedBrush}" FontSize="14" Margin="0,7,0,24" />

                    <Border CornerRadius="18" Padding="30" MinHeight="258" Background="{DynamicResource HeroBrush}"
                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.16*" />
                                <ColumnDefinition Width="0.84*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" MaxWidth="490">
                                <Border Background="{DynamicResource BrandTintBrush}" CornerRadius="20" Padding="11,6" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource TealHoverBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="  AI-ASSISTED, HUMAN-REVIEWED" Foreground="{DynamicResource TealHoverBrush}"
                                                   FontSize="9" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Find the version your team can trust."
                                           Foreground="{DynamicResource InkBrush}" FontSize="27" FontWeight="SemiBold"
                                           TextWrapping="Wrap" LineHeight="34" Margin="0,17,0,9" />
                                <TextBlock Text="Surface likely duplicate guidance, see the evidence, and decide what to do next - together."
                                           Foreground="{DynamicResource MutedBrush}" FontSize="13" TextWrapping="Wrap" LineHeight="20"
                                           MaxWidth="470" />
                                <Button Content="Connect to Confluence" Style="{StaticResource PrimaryButtonStyle}"
                                        HorizontalAlignment="Left" Margin="0,21,0,0"
                                        Click="ConnectSampleButton_Click" />
                                <TextBlock Text="Secure token storage. Live, read-only page comparison."
                                           Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0" />
                            </StackPanel>

                            <Grid Grid.Column="1" Width="300" Height="205" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse Width="190" Height="190" Fill="{DynamicResource BrandTintBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <Border Width="128" Height="158" Background="{DynamicResource InputBrush}" CornerRadius="10"
                                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="16,17"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <RotateTransform Angle="-8" />
                                    </Border.RenderTransform>
                                    <StackPanel>
                                        <Border Width="27" Height="7" Background="{DynamicResource MutedBrush}" CornerRadius="3" HorizontalAlignment="Left" />
                                        <Border Height="4" Background="{DynamicResource LineBrush}" CornerRadius="2" Margin="0,15,12,0" />
                                        <Border Height="4" Background="{DynamicResource LineBrush}" CornerRadius="2" Margin="0,7,4,0" />
                                        <Border Height="4" Background="{DynamicResource LineBrush}" CornerRadius="2" Margin="0,7,16,0" />
                                        <Border Height="28" Background="{DynamicResource BrandTintBrush}" CornerRadius="5" Margin="0,14,0,0" />
                                        <Border Height="4" Background="{DynamicResource LineBrush}" CornerRadius="2" Margin="0,12,8,0" />
                                    </StackPanel>
                                </Border>
                                <Border Width="128" Height="158" Background="{DynamicResource PanelBrush}" CornerRadius="10"
                                        BorderBrush="{DynamicResource TealBrush}" BorderThickness="1" Padding="16,17"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <RotateTransform Angle="7" />
                                    </Border.RenderTransform>
                                    <StackPanel>
                                        <Border Width="27" Height="7" Background="{DynamicResource TealHoverBrush}" CornerRadius="3" HorizontalAlignment="Left" />
                                        <Border Height="4" Background="{DynamicResource LineBrush}" CornerRadius="2" Margin="0,15,12,0" />
                                        <Border Height="4" Background="{DynamicResource LineBrush}" CornerRadius="2" Margin="0,7,4,0" />
                                        <Border Height="4" Background="{DynamicResource LineBrush}" CornerRadius="2" Margin="0,7,16,0" />
                                        <Border Height="28" Background="{DynamicResource SelectionBrush}" CornerRadius="5" Margin="0,14,0,0" />
                                        <Border Height="4" Background="{DynamicResource LineBrush}" CornerRadius="2" Margin="0,12,8,0" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="11,9"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,7">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{DynamicResource TealBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="  Illustration" Foreground="{DynamicResource InkBrush}"
                                                   FontSize="10" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <StackPanel Margin="0,30,0,14">
                        <TextBlock Text="HOW IT WORKS" Foreground="{DynamicResource TealBrush}"
                                   FontSize="10" FontWeight="Bold" />
                        <TextBlock Text="From possible copies to confident decisions"
                                   Foreground="{DynamicResource InkBrush}" FontSize="19"
                                   FontWeight="SemiBold" Margin="0,7,0,0" />
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="19" MinHeight="154">
                            <StackPanel>
                                <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource BrandTintBrush}" HorizontalAlignment="Left">
                                    <TextBlock Text="01" Foreground="{DynamicResource TealBrush}" FontSize="11"
                                               FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Find likely copies" Foreground="{DynamicResource InkBrush}"
                                           FontSize="14" FontWeight="SemiBold" Margin="0,13,0,5" />
                                <TextBlock Text="Compare approved pages to surface exact and near-duplicate guidance."
                                           Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                           TextWrapping="Wrap" LineHeight="18" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="19" MinHeight="154">
                            <StackPanel>
                                <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource BrandTintBrush}" HorizontalAlignment="Left">
                                    <TextBlock Text="02" Foreground="{DynamicResource TealBrush}" FontSize="11"
                                               FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="See the evidence" Foreground="{DynamicResource InkBrush}"
                                           FontSize="14" FontWeight="SemiBold" Margin="0,13,0,5" />
                                <TextBlock Text="Review source links, matching details, and meaningful differences."
                                           Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                           TextWrapping="Wrap" LineHeight="18" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="19" MinHeight="154">
                            <StackPanel>
                                <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource BrandTintBrush}" HorizontalAlignment="Left">
                                    <TextBlock Text="03" Foreground="{DynamicResource TealBrush}" FontSize="11"
                                               FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Decide together" Foreground="{DynamicResource InkBrush}"
                                           FontSize="14" FontWeight="SemiBold" Margin="0,13,0,5" />
                                <TextBlock Text="Choose a next step. Nothing is changed or archived automatically."
                                           Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                           TextWrapping="Wrap" LineHeight="18" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Background="{DynamicResource BrandTintBrush}" CornerRadius="10" Padding="15,12" Margin="0,18,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource TealBrush}"
                                       FontSize="15" VerticalAlignment="Center" Margin="0,0,11,0" />
                            <TextBlock Text="Human review comes first." Foreground="{DynamicResource InkBrush}"
                                       FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="  DocTwin offers suggestions; your team makes every decision."
                                       Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="34,0,38,0">
                    <TextBlock Text="DocTwin  |  Knowledge Integrity Copilot  |  #Breakthrough Build" Foreground="{DynamicResource MutedBrush}"
                               FontSize="11" VerticalAlignment="Center" />
                    <TextBlock Text="Developed by Dawood Ali" Foreground="{DynamicResource MutedBrush}"
                               FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
