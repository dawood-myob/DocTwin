<Window x:Class="DocTwin.ConfluenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DocTwin"
        Title="Confluence duplicate discovery | DocTwin" Icon="Assets/DocTwin.ico" Style="{StaticResource WindowStyle}"
        Width="1240" Height="880" MinWidth="940" MinHeight="720"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource CanvasBrush}" FontFamily="Segoe UI">
    <Window.Resources>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" Padding="26,18" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <ContentControl ContentTemplate="{StaticResource BrandMarkTemplate}" VerticalAlignment="Center" />
                <StackPanel Margin="13,0,0,0">
                    <WrapPanel>
                        <Button Content="Switch theme" Click="ThemeButton_Click" Style="{StaticResource QuietButtonStyle}" ToolTip="Switch between Light and Dark. Your appearance preference is saved locally." />
                        <Button Content="_Help" Click="HelpButton_Click" Style="{StaticResource QuietButtonStyle}" ToolTip="Search offline guidance for scans, AI, permissions and troubleshooting." />
                    </WrapPanel>
                    <TextBlock Text="Confluence duplicate discovery" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" />
                    <TextBlock Text="Choose a root. Discover duplicates across spaces. Review the evidence." Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>
        <TabControl SelectedIndex="{Binding SelectedTab}" Grid.Row="1" Margin="24,18,24,12" BorderThickness="0" Background="Transparent">
            <TabItem Header="1. Connection &amp; token" Padding="16,10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22,12,22,22" MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Text="Confluence Cloud connection" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
                        <TextBlock Text="Use an organisation-approved Atlassian API token. This connection uses direct REST APIs, not your IDE's Rovo MCP sign-in."
                                   Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0" />
                        <StackPanel IsEnabled="{Binding IsIdle}">
                            <TextBlock Text="Site URL" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Site, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Confluence site URL"
                                     ToolTip="https://example.atlassian.net" MaxLength="250" />
                            <TextBlock Text="Atlassian account email" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Atlassian account email" MaxLength="320" />
                            <CheckBox Content="Scoped API token (recommended)" IsChecked="{Binding ScopedToken}" Margin="0,17,0,0" />
                            <TextBlock Text="Site Cloud ID (required for scoped tokens)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding CloudId, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ScopedToken}"
                                     AutomationProperties.Name="Confluence Cloud ID" MaxLength="36" />
                            <TextBlock Text="Where to find your Cloud ID" Foreground="{DynamicResource InkBrush}"
                                       FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0" />
                            <TextBlock Text="In your browser, open your site URL followed by /_edge/tenant_info (for example, https://example.atlassian.net/_edge/tenant_info). Copy only the UUID value beside cloudId in the JSON response into this field. This is the site identifier, not a page ID. If unavailable, ask your Atlassian administrator."
                                       Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <TextBlock Text="Enter the Cloud ID before the token: changing this field clears the session token. If your token was created without scopes, uncheck Scoped API token; no Cloud ID is needed."
                                       Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                            <TextBlock Text="API token (leave empty to use a loaded saved token)" Style="{StaticResource FieldLabel}" />
                            <PasswordBox x:Name="TokenBox" PasswordChanged="TokenBox_PasswordChanged" Padding="10,8"
                                         AutomationProperties.Name="Confluence API token" />
                            <TextBlock Text="{Binding CredentialStatus}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0" />
                            <TextBlock Text="Scoped tokens need read:page:confluence and read:user:confluence for the connection test. No write scope is needed. Changing site, email, token type or Cloud ID clears the session token."
                                       Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" />
                            <CheckBox IsChecked="{Binding Authorised}" Margin="0,17,0,0">
                                <TextBlock Text="My organisation permits this token-based connection and I am authorised to read the selected pages."
                                           TextWrapping="Wrap" />
                            </CheckBox>
                            <CheckBox IsChecked="{Binding SaveConsent}" Margin="0,12,0,0">
                                <TextBlock Text="I consent to saving this connection and token in Windows Credential Manager for my Windows account."
                                           TextWrapping="Wrap" />
                            </CheckBox>
                        </StackPanel>
                        <WrapPanel Margin="0,20,0,0">
                            <Button Content="Test connection" Command="{Binding TestCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" />
                            <Button Content="Save validated token" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" />
                            <Button Content="Remove saved connection" Style="{StaticResource QuietButtonStyle}" Click="RemoveButton_Click" Margin="0,0,0,8" IsEnabled="{Binding IsIdle}" />
                        </WrapPanel>
                        <TextBlock Text="Saving is optional and available only after a successful connection test and explicit consent. Saved tokens are never displayed or written to app settings, logs or SQLite."
                                   Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="2. Discover duplicates" Padding="16,10"><local:DiscoveryView /></TabItem><TabItem Header="3. Review page pair" Padding="16,10">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*" /><RowDefinition Height="3*" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,8,0"><StackPanel IsEnabled="{Binding IsIdle}">
                        <TextBlock Text="Compare two pages from your configured site" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
                        <TextBlock Text="Choose Review selected finding to load the selected scan result, or enter two URLs below and fetch live pages. Opening this tab alone does not load a pair. Selection does not establish authority."
                                   Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Text="Source / reference page URL" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding SourceUrl, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Source Confluence page URL" MaxLength="2048" />
                        <TextBlock Text="Candidate page URL" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding CandidateUrl, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Candidate Confluence page URL" MaxLength="2048" />
                    </StackPanel>
                    <WrapPanel Margin="0,8,0,8">
                        <Button Content="Review selected finding" Command="{Binding ReviewFindingCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" /><Button Content="Fetch &amp; compare live pages" Command="{Binding CompareCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                        <Button Content="Prepare AI for this finding" Command="{Binding PrepareAiPairCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" />
                    </WrapPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding SourceDetails}" TextWrapping="Wrap" Foreground="{DynamicResource InkBrush}" />
                            <Button Content="Open source in browser" Style="{StaticResource QuietButtonStyle}" HorizontalAlignment="Left" Click="OpenSourceButton_Click" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding CandidateDetails}" TextWrapping="Wrap" Foreground="{DynamicResource InkBrush}" />
                            <Button Content="Open candidate in browser" Style="{StaticResource QuietButtonStyle}" HorizontalAlignment="Left" Click="OpenCandidateButton_Click" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,10" /></StackPanel></ScrollViewer>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True" RowHeaderWidth="0"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderBrush="{DynamicResource LineBrush}"
                              AutomationProperties.Name="Confluence duplicate discovery evidence" FrozenColumnCount="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Evidence" Binding="{Binding Kind}" Width="110" />
                            <DataGridTextColumn Header="#" Binding="{Binding SourceLine}" Width="40" />
                            <DataGridTextColumn Header="Source page text" Binding="{Binding SourceText}" Width="*">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Padding" Value="6" /></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="#" Binding="{Binding CandidateLine}" Width="40" />
                            <DataGridTextColumn Header="Candidate page text" Binding="{Binding CandidateText}" Width="*">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Padding" Value="6" /></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="48" Margin="0,6,0,0"><TextBlock Text="{Binding Limitations}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11" /></ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="4. AI analysis (optional)" Padding="16,10"><local:AiAnalysisView /></TabItem></TabControl>
        <Border Grid.Row="2" Background="{DynamicResource BrandTintBrush}" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center"
                           AutomationProperties.AutomationId="ConfluenceOperationStatus" AutomationProperties.LiveSetting="Polite" />
                <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource QuietButtonStyle}" Margin="14,0,0,0" />
            </Grid>
        </Border>
        <Border Grid.Row="3" Background="{DynamicResource PanelBrush}" Padding="24,12">
            <Grid>
                <TextBlock Text="Read-only prototype - no Confluence changes are made" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                <TextBlock Text="Developed by Dawood Ali" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
