<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\DocTwin.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\DocTwin.ico" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="AngleSharp" Version="1.10.4" />
    <PackageReference Include="DiffPlex" Version="1.9.0" />
    <PackageReference Include="GitHub.Copilot.SDK" Version="1.0.28" />
    <PackageReference Include="Polly" Version="8.9.1" />
    <PackageReference Include="Polly.RateLimiting" Version="8.9.1" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

</Project>
