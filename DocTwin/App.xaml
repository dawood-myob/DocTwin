<Application x:Class="DocTwin.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/EmeraldPalette.xaml" />
                <ResourceDictionary Source="Themes/ModernControls.xaml" />
            </ResourceDictionary.MergedDictionaries>

        <DataTemplate x:Key="BreakthroughBadgeTemplate">
            <Border Background="{DynamicResource BreakthroughBrush}" CornerRadius="12" Padding="10,3" VerticalAlignment="Center"
                    AutomationProperties.Name="Breakthrough Build">
                <TextBlock Text="#Breakthrough Build" Foreground="#FFFFFFFF" FontSize="11" FontWeight="SemiBold" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="BrandMarkTemplate">
            <Viewbox Width="42" Height="42" Stretch="Uniform">
                <Grid Width="42" Height="42">
                    <Border Background="{DynamicResource BrandTintBrush}" CornerRadius="13" />
                    <Path Data="M 9,8 H 23 L 28,13 V 32 H 9 Z M 23,8 V 13 H 28"
                          Fill="{DynamicResource PanelBrush}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.7"
                          StrokeLineJoin="Round" />
                    <Path Data="M 18,12 H 29 L 34,17 V 34 H 18 Z M 29,12 V 17 H 34"
                          Fill="{DynamicResource TealBrush}" Stroke="{DynamicResource TealBrush}" StrokeThickness="1.5"
                          StrokeLineJoin="Round" />
                    <Path Data="M 22,23 H 30 M 22,27 H 30"
                          Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                </Grid>
            </Viewbox>
        </DataTemplate>

        </ResourceDictionary>
    </Application.Resources>
</Application>
